{
  "manifest_version": 3,
  "name": "Lavender Tabs",
  "version": "1.0.0",
  "description": "Dark Brave theme where the tab you're on is lavender, so it's easy to spot.",
  "theme": {
    "colors": {
      "frame": [19, 17, 24],
      "frame_inactive": [14, 12, 18],
      "background_tab": [19, 17, 24],
      "background_tab_inactive": [14, 12, 18],
      "tab_background_text": [141, 135, 152],
      "tab_background_text_inactive": [110, 105, 120],

      "toolbar": [70, 56, 116],
      "tab_text": [240, 232, 255],
      "toolbar_text": [233, 223, 255],
      "toolbar_button_icon": [203, 184, 245],
      "bookmark_text": [230, 220, 250],

      "omnibox_background": [29, 24, 40],
      "omnibox_text": [236, 230, 246],

      "ntp_background": [19, 17, 24],
      "ntp_text": [230, 220, 250]
    }
  }
}
